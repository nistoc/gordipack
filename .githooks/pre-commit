#!/bin/sh
# Перехватчик git pre-commit пакета: не пускает в commit литералы донора в коде ядра
# (карточка #678, этап Э4, шаг Ш1, пункт д).
#
# ЗАЧЕМ. Проверку vnext/tools/guard-donor-literals.py до сих пор звал только
# vnext/tools/sync-to-template.py — то есть тот, кто переносит файлы из контура-донора.
# Рука, правящая пакет напрямую, проверку не вызывала. Здесь её зовёт сам git перед каждым
# commit, и от того, кто и как правит, вызов больше не зависит.
#
# ВКЛЮЧЕНИЕ — одна команда в каждом клоне (настройка живёт в клоне и вместе с репозиторием не едет):
#     git config core.hooksPath .githooks
#
# ИСХОД. Проверка чисто (код 0) — commit идёт молча. Находки (код 1) — commit отменён, находки
# напечатаны. Проверить не удалось (код 2: нет файла данных, нет git и т. п.) — commit тоже отменён:
# «не проверено» не бывает «чисто». Нет python 3 или нет самой проверки — отмена со словами, не молчание.
#
# ГРАНИЦА — ЧТО ИМЕННО СУДИТСЯ. Проверка читает РАБОЧЕЕ ДЕРЕВО, то есть файлы на диске, а не индекс
# (guard-donor-literals.py без --commit берёт список файлов у git, а текст — с диска). Отсюда:
#   · литерал в правке, которую вы НЕ добавили в commit, тоже отменит commit — проверка видит диск;
#   · литерал, добавленный в индекс, но уже убранный на диске (git add, затем правка; git add -p),
#     перехватчик ПРОПУСТИТ, хотя в commit он уедет. Закрывает эту щель проверка уже сделанного
#     commit: python vnext/tools/guard-donor-literals.py --commit HEAD
# Другие границы: проверяется весь пакет, а не только изменённые файлы; `git commit --no-verify`
# перехватчик обходит; в клоне без настройки core.hooksPath он не работает.
#
# Файл исполняет sh из Git for Windows; окончания строк закреплены как LF в .gitattributes.

root=$(git rev-parse --show-toplevel) || exit 1
guard="$root/vnext/tools/guard-donor-literals.py"

if [ ! -f "$guard" ]; then
    echo "⛔ commit ОТМЕНЁН: нет файла проверки $guard — литералы донора проверить нечем." >&2
    echo "   «Не проверено» не значит «чисто», поэтому commit не пропускается." >&2
    exit 1
fi

# первый python 3, который запускается (заглушка Microsoft Store и python 2 не подходят)
py=
for candidate in python python3 py; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c "import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)" >/dev/null 2>&1; then
        py=$candidate
        break
    fi
done
if [ -z "$py" ]; then
    echo "⛔ commit ОТМЕНЁН: не найден python 3 — литералы донора проверить нечем." >&2
    echo "   Поставьте python 3 (команды python, python3 или py) и повторите commit." >&2
    exit 1
fi

out=$("$py" "$guard" 2>&1)
code=$?

case $code in
    0)
        exit 0
        ;;
    1)
        printf '%s\n' "$out" >&2
        echo "" >&2
        echo "⛔ commit ОТМЕНЁН: в коде ядра пакета найдены литералы донора (список выше)." >&2
        echo "   Вынесите литерал в настройки либо внесите строку в перечень исключений" >&2
        echo "   vnext/tools/donor-literals-allowed.tsv с причиной." >&2
        echo "   Посмотреть и проверить заново: python $guard" >&2
        echo "   Проверка читает файлы на диске, не индекс: правьте файл на диске." >&2
        exit 1
        ;;
    *)
        printf '%s\n' "$out" >&2
        echo "" >&2
        echo "⛔ commit ОТМЕНЁН: литералы донора проверить НЕ УДАЛОСЬ (причина — выше, код $code)." >&2
        echo "   «Не проверено» не значит «чисто», поэтому commit не пропускается." >&2
        echo "   Посмотреть: python $guard" >&2
        exit 1
        ;;
esac
