<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Gordi.Viewer.Api</RootNamespace>
    <AssemblyName>Gordi.Viewer.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      НАМЕРЕННО .Core + bundle, а НЕ мета-пакет Microsoft.Data.Sqlite.
      Причина — замер локального кэша NuGet 2026-08-06: мета-пакета в кэше нет,
      а .Core (10.0.8) и bundle_e_sqlite3 (2.1.11) есть ⇒ восстановление проходит
      БЕЗ обращения к сети. Мета-пакет сам по себе ничего не добавляет: он ровно
      эта пара. Если версии в кэше другие — правь здесь, это единственное место.
    -->
    <!--
      🔐 ВЕРСИИ ПОДНЯТЫ 2026-08-06 16:45 UTC по слову владельца: пара 10.0.8 + 2.1.11
      давала NU1903 — известную уязвимость ВЫСОКОЙ степени (GHSA-2m69-gcr7-jv3q)
      в SQLitePCLRaw 2.1.11.
      ⚠️ Граница, названная до того, как о ней спросят: проверена СБОРКА, не ЗАПУСК.
      Переход 2.x → 3.x мажорный и шире того, что объявляет зависимостью сам
      Microsoft.Data.Sqlite.Core. Первый живой запуск обязан подтвердить, что база
      вообще открывается; до этого замена проверена наполовину.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
